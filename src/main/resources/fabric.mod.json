{
  "schemaVersion": 1,
  "id": "schemapart",
  "version": "${version}",
  "name": "Schemapart",
  "description": "In-game map art studio: block palette scanning, previews and Litematica schematic export.",
  "authors": ["Schemapart contributors"],
  "license": "MIT",
  "icon": "assets/schemapart/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["com.schemapart.client.SchemapartClient"]
  },
  "mixins": [
    {
      "config": "schemapart.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.2",
    "java": ">=25"
  }
}
